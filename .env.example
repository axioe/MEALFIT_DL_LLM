# 복사해서 .env로 사용 (.env는 커밋하지 않는다)
# docker compose가 이 값을 읽는다. Spring은 같은 이름의 환경 변수를 읽고, 없으면 application.yml 기본값을 쓴다.

# 로컬 PostgreSQL (docker compose up -d 로 띄우는 pgvector/pgvector:pg16)
DB_PORT=5432
DB_NAME=mealfit
DB_USERNAME=mealfit
DB_PASSWORD=mealfit

# 공유/배포 서버에서는 반드시 교체: openssl rand -base64 48
# JWT_SECRET=

# Python AI 서비스 주소 (Gemini 키는 AI 서비스 쪽 .env에만 둔다)
AI_SERVICE_URL=http://localhost:8000

# [이메일인증] 기본은 log(콘솔 출력). 실제 발송 시 smtp로 변경하고 아래 값을 채운다.
MAIL_PROVIDER=log
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
MAIL_FROM_NAME=MealFit
FRONTEND_BASE_URL=http://localhost:5173

# [소셜로그인] Google·Naver·Kakao OAuth2 키 (발급받은 값을 .env에만 둔다)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
