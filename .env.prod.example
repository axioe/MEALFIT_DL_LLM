# 운영 서버(EC2)용. 서버에서 cp .env.prod.example .env 후 값을 채운다. 이 파일에는 실제 값을 넣지 않는다.
# 비밀번호 생성: openssl rand -base64 24

# DB: Amazon RDS for PostgreSQL 16. 엔드포인트·비밀번호는 이 서버 .env에만 둔다
# RDS 인증서 번들은 서버의 /etc/mealfit/rds-global-bundle.pem (backend 컨테이너에 읽기 전용으로 붙는다)
#   sudo mkdir -p /etc/mealfit && sudo curl -o /etc/mealfit/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/mealfit?sslmode=verify-full&sslrootcert=/etc/mealfit/rds-global-bundle.pem
DB_USERNAME=mealfit
DB_PASSWORD=
# 인증서 폴더를 다른 곳에 두었을 때만 바꾼다
# RDS_CA_DIR=/etc/mealfit

# 로그인 토큰 서명 키. 필수. 생성: openssl rand -base64 48
# 바꾸면 기존 로그인이 모두 풀린다
JWT_SECRET=

# ai-service가 아직 없으면 그대로 둔다 → 호출 실패 시 로컬 대체 식단으로 동작
AI_SERVICE_URL=http://ai-service:8000

# Gemini 키는 이 서버 .env에만 둔다. 비워 두면 AI 대신 검증된 로컬 대체 식단으로 동작
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
